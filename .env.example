# ─── IranMonitor — Environment Variables ───────────────────────────
# این فایل رو کپی کنید به .env و مقادیر رو تنظیم کنید
# cp .env.example .env

# ─── دیتابیس (SQLite) ───────────────────────────────────────────
# مسیر فایل دیتابیس محلی (SQLite)
# در سیستم خودتون: file:./db/custom.db
DATABASE_URL="file:./db/custom.db"

# ─── پورت‌ها ───────────────────────────────────────────────────
# Next.js فرانت‌اند + API — پیش‌فرض ۳۰۰۰
# پورت در package.json تنظیم شده، نیازی به متغیر نیست

# Python FastAPI — پیش‌فرض ۸۰۰۰
# پورت در mini-services/iran-monitor-api/index.py هاردکد شده

# ─── کلید API هوش مصنوعی (z-ai) ────────────────────────────────
# زد-ای SDK به‌صورت خودکار احراز هویت می‌کند
# اگر نیاز به کلید جداگانه بود:
# ZAI_API_KEY="your-api-key-here"

# ─── منابع داده خارجی ──────────────────────────────────────────
# همه منابع رایگان هستند و نیازی به کلید API ندارند:
# - USGS (زلزله): https://earthquake.usgs.gov
# - wttr.in (آب‌وهوا): https://wttr.in
# - Open-Meteo (کیفیت هوا): https://open-meteo.com
# - CoinGecko (کریپتو): https://coingecko.com
# - open.er-api.com (نرخ ارز): https://open.er-api.com
# - gold-api.com (طلا): https://gold-api.com
# - RSS خبرگزاری‌ها: مهر، ایسنا، مشرق

# ─── تنظیمات اختیاری ───────────────────────────────────────────
# NODE_ENV: production یا development
# NODE_ENV="development"
